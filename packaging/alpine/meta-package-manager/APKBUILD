# Maintainer: Kevin Deldycke <kevin@deldycke.com>

# Targets Alpine edge: py3-uv-build (mpm's native build backend) and the
# py3-boltons >= 25 floor are not available in the stable branches.
# backports-strenum and tomli are omitted from depends: both are
# Python < 3.11 markers and edge's python3 is newer.
pkgname=meta-package-manager
pkgver=7.4.1
pkgrel=0
pkgdesc="Wraps all package managers with a unifying CLI"
url="https://mpm.run/"
arch="noarch"
license="GPL-2.0-or-later"
depends="
	python3
	py3-boltons
	py3-click-extra
	py3-extra-platforms
	py3-packageurl
	py3-tomli-w
	py3-xmltodict
	"
makedepends="py3-gpep517 py3-installer py3-uv-build"
checkdepends="py3-pytest py3-tomlkit py3-yaml"
subpackages="$pkgname-pyc"
source="https://files.pythonhosted.org/packages/source/m/meta-package-manager/meta_package_manager-$pkgver.tar.gz"
builddir="$srcdir/meta_package_manager-$pkgver"

build() {
	gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2
}

check() {
	python3 -m venv --clear --without-pip --system-site-packages .testenv
	.testenv/bin/python3 -m installer .dist/*.whl
	.testenv/bin/mpm --version
	# Run the hermetic unit layer only, skipping the integration tests
	# (marked "integration") that drive the real package managers.
	.testenv/bin/python3 -m pytest -m "not integration"
}

package() {
	python3 -m installer -d "$pkgdir" \
		.dist/*.whl
}

sha512sums="
822676eb23a05bd2d5a053d5ab67e122a4b7af2371d586c7cdd8c29d8201f069149a76c02ec53a1ed9ad3b3c27601433ff43903b5847806e3d5cac569b443e22  meta_package_manager-7.4.1.tar.gz
"
