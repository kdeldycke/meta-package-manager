# Maintainer: Kevin Deldycke <kevin@deldycke.com>
pkgname=meta-package-manager
pkgver=8.3.0
pkgrel=0
pkgdesc="Wraps all package managers with a unifying CLI"
url="https://mpm.run/"
arch="noarch"
license="GPL-2.0-or-later"
depends="
	python3
	py3-click-extra
	py3-extra-platforms
	py3-tomli-w
	"
makedepends="py3-gpep517 py3-installer py3-uv-build"
# Beyond pytest, the hermetic test layer imports pyyaml and applies the
# xdist_group marker, which pytest-xdist registers: strict_markers rejects an
# unregistered one. The SBOM and tomlrt tests skip themselves when their
# libraries are absent.
checkdepends="py3-pytest py3-pytest-xdist py3-yaml"
subpackages="$pkgname-pyc"
source="https://files.pythonhosted.org/packages/source/m/meta-package-manager/meta_package_manager-$pkgver.tar.gz"
builddir="$srcdir/meta_package_manager-$pkgver"

build() {
	gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2
}

check() {
	python3 -m venv --clear --without-pip --system-site-packages .testenv
	.testenv/bin/python3 -m installer .dist/*.whl
	.testenv/bin/mpm --version
	# Run the hermetic unit layer only, skipping the integration tests
	# (marked "integration") that drive the real package managers.
	.testenv/bin/python3 -m pytest -m "not integration"
}

package() {
	python3 -m installer -d "$pkgdir" \
		.dist/*.whl
}

sha512sums="
4436cf879b033e9bbc19b5021a33b9c6b02f6b10fb5658726e2e6cfedc9d7c41b7bfb7a35cd8bde0963e6e4147aee920b312c52b4115344db5a4d58c321cae47  meta_package_manager-8.3.0.tar.gz
"
