# Maintainer: Kevin Deldycke <kevin@deldycke.com>

# py3-click and py3-wcwidth come from this overlay: edge carries 8.4.2 and
# 0.6.0, below the click >= 8.5 and wcwidth >= 0.8.3 floors.
pkgname=py3-click-extra
pkgver=10.2.0
pkgrel=0
pkgdesc="Drop-in replacement for Click to build user-friendly and colorful CLIs"
url="https://github.com/kdeldycke/click-extra"
arch="noarch"
license="GPL-2.0-or-later"
depends="
	python3
	py3-click
	py3-cloup
	py3-extra-platforms
	py3-tabulate
	py3-wcmatch
	py3-wcwidth
	"
makedepends="py3-gpep517 py3-installer py3-uv-build"
# Libraries and tools the tests need: tomlrt writes the TOML tables and
# exports they check. Sphinx and myst-parser are omitted: they only serve
# tests/sphinx/, which asserts on the exact HTML Sphinx and Pygments emit;
# upstream skips that tree when they are absent.
checkdepends="
	git
	py3-hjson
	py3-jsonschema
	py3-pygments
	py3-pytest
	py3-pytest-httpserver
	py3-requests
	py3-tomlrt
	py3-yaml
	"
subpackages="$pkgname-pyc"
source="https://files.pythonhosted.org/packages/source/c/click-extra/click_extra-$pkgver.tar.gz"
builddir="$srcdir/click_extra-$pkgver"

build() {
	gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2
}

check() {
	# Run the sdist's test suite against the installed wheel, minus the network
	# tests (the build sandbox has no outbound network).
	python3 -m venv --clear --without-pip --system-site-packages .testenv
	.testenv/bin/python3 -m installer .dist/*.whl
	.testenv/bin/python3 -m pytest -m "not network"
}

package() {
	python3 -m installer -d "$pkgdir" \
		.dist/*.whl
}

sha512sums="
cb129b6bf265a37bc438afbfbeb73cca4e92f0f0155f213554559ae39fa987d3a8239e0f12cdd4ed1c1aa481eeb7d12192b3514818d12878689e245af0871466  click_extra-10.2.0.tar.gz
"
