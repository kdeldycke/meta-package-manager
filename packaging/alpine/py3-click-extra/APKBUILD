# Maintainer: Kevin Deldycke <kevin@deldycke.com>
pkgname=py3-click-extra
pkgver=8.6.1
pkgrel=0
pkgdesc="Drop-in replacement for Click to build user-friendly and colorful CLIs"
url="https://github.com/kdeldycke/click-extra"
arch="noarch"
license="GPL-2.0-or-later"
# tabulate's widechars extra resolves to wcwidth, listed explicitly. tomli is
# omitted: it is a Python < 3.11 marker and edge's python3 is newer.
depends="
	python3
	py3-boltons
	py3-click
	py3-cloup
	py3-deepmerge
	py3-extra-platforms
	py3-tabulate
	py3-wcmatch
	py3-wcwidth
	"
makedepends="py3-gpep517 py3-installer py3-uv-build"
# Optional libraries the test modules import at collection time (git backs the
# matrix tests' synthetic repositories; httpserver drives remote config loading;
# sphinx and myst-parser build the documentation fixtures).
checkdepends="
	git
	py3-hjson
	py3-jsonschema
	py3-myst-parser
	py3-pygments
	py3-pytest
	py3-pytest-httpserver
	py3-requests
	py3-sphinx
	py3-tomlkit
	py3-xmltodict
	py3-yaml
	"
subpackages="$pkgname-pyc"
source="https://files.pythonhosted.org/packages/source/c/click-extra/click_extra-$pkgver.tar.gz"
builddir="$srcdir/click_extra-$pkgver"

build() {
	gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2
}

check() {
	# The sdist ships the test suite since 8.6.1. Run it against the installed
	# wheel, excluding the network tests (no outbound network in the build
	# sandbox). The MkDocs tests self-skip without mkdocs-click, and the runner
	# fixture pins $HOME so the config-search tests do not leak the build HOME.
	# The two process-group tests are deselected: they kill a session leader and
	# assert its grandchild is reaped, which the build container (no PID 1 init
	# to reap orphans) cannot guarantee.
	# See: https://kdeldycke.github.io/click-extra/packaging.html
	python3 -m venv --clear --without-pip --system-site-packages .testenv
	.testenv/bin/python3 -m installer .dist/*.whl
	.testenv/bin/python3 -m pytest -m "not network" \
		--deselect tests/test_execution.py::test_run_cli_timeout_new_session_kills_grandchildren \
		--deselect tests/test_execution.py::test_terminate_live_processes_signals_whole_group
}

package() {
	python3 -m installer -d "$pkgdir" \
		.dist/*.whl
}

sha512sums="
73fdad3c1f3c7ef95405b2a304271a1fdd836e820d656c81016565136eb74c9783158d1621188120602bdb7100ccc0702122a059f0383b0a3c49706708d2a056  click_extra-8.6.1.tar.gz
"
