# Maintainer: Kevin Deldycke <kevin@deldycke.com>

# typing-extensions is omitted from depends: it is a Python < 3.12 marker and
# edge's python3 is newer. The tests import it, so it is a check dependency.
pkgname=py3-cloup
pkgver=4.0.0
pkgrel=0
pkgdesc="Click extension with option groups, constraints, aliases and themed help"
url="https://github.com/janluke/cloup"
arch="noarch"
license="BSD-3-Clause"
depends="
	python3
	py3-click
	"
makedepends="py3-gpep517 py3-hatch-vcs py3-hatchling py3-installer"
checkdepends="py3-pytest py3-typing-extensions"
subpackages="$pkgname-pyc"
source="https://files.pythonhosted.org/packages/source/c/cloup/cloup-$pkgver.tar.gz"
builddir="$srcdir/cloup-$pkgver"

build() {
	gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2
}

check() {
	python3 -m venv --clear --without-pip --system-site-packages .testenv
	.testenv/bin/python3 -m installer .dist/*.whl
	.testenv/bin/python3 -m pytest tests
}

package() {
	python3 -m installer -d "$pkgdir" \
		.dist/*.whl
}

sha512sums="
d5f7961ed9eb895b920be6eed53eaeaba4fdcf85f4fc4017a6ea3d58a25931c946d0a74493ee903aec0279a8d407368ceede2767cd6fdb5581fa989e452e036f  cloup-4.0.0.tar.gz
"
