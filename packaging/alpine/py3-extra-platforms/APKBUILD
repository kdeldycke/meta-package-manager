# Maintainer: Kevin Deldycke <kevin@deldycke.com>
pkgname=py3-extra-platforms
pkgver=14.0.1
pkgrel=0
pkgdesc="Detect platforms, OSes, distributions and group them by family"
url="https://github.com/kdeldycke/extra-platforms"
arch="noarch"
license="Apache-2.0"
depends="python3"
makedepends="py3-gpep517 py3-installer py3-uv-build"
checkdepends="py3-pytest"
subpackages="$pkgname-pyc"
source="https://files.pythonhosted.org/packages/source/e/extra-platforms/extra_platforms-$pkgver.tar.gz"
builddir="$srcdir/extra_platforms-$pkgver"

build() {
	gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2
}

check() {
	# Run the sdist's test suite against the installed wheel, minus the network
	# tests (the build sandbox has no outbound network) and the benchmark tests,
	# which budget wall-clock time: they measure the builder rather than the
	# package, and the emulated arches exceed them.
	python3 -m venv --clear --without-pip --system-site-packages .testenv
	.testenv/bin/python3 -m installer .dist/*.whl
	.testenv/bin/python3 -m pytest -m "not network and not benchmark"
}

package() {
	python3 -m installer -d "$pkgdir" \
		.dist/*.whl
}

sha512sums="
9b93f63c69ddfe832dfc41647447f2956da6721f9b5ffb0336e0cfc7afd98b36674763c2ce6909eb7080d74b2205f2c00e7b6edad1e464f690122746272f5a3c  extra_platforms-14.0.1.tar.gz
"
