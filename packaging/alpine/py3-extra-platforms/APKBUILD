# Maintainer: Kevin Deldycke <kevin@deldycke.com>
pkgname=py3-extra-platforms
pkgver=13.5.1
pkgrel=0
pkgdesc="Detect platforms, OSes, distributions and group them by family"
url="https://github.com/kdeldycke/extra-platforms"
arch="noarch"
license="Apache-2.0"
depends="python3"
makedepends="py3-gpep517 py3-installer py3-uv-build"
checkdepends="py3-pytest"
subpackages="$pkgname-pyc"
source="https://files.pythonhosted.org/packages/source/e/extra-platforms/extra_platforms-$pkgver.tar.gz"
builddir="$srcdir/extra_platforms-$pkgver"

build() {
	gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2
}

check() {
	# The sdist ships the test suite since 13.4.0, so run it against the
	# installed wheel. Exclude the network tests (no outbound network in the
	# build sandbox); the environment-detection tests adapt to the sandbox and
	# the Sphinx cross-reference test self-skips when uv is absent. Since 13.5.1
	# the GitHub-runner test self-skips outside its own matrix job, so the CI
	# environment abuild inherits no longer needs scrubbing here.
	# See: https://kdeldycke.github.io/extra-platforms/packaging.html
	python3 -m venv --clear --without-pip --system-site-packages .testenv
	.testenv/bin/python3 -m installer .dist/*.whl
	.testenv/bin/python3 -m pytest -m "not network"
}

package() {
	python3 -m installer -d "$pkgdir" \
		.dist/*.whl
}

sha512sums="
7bd55c03f9781069e2af1dcc5f413872a66912b9b31eeadd7432a997ed9755030b74907f11e84d2a4ae2774c9535a6f3551e5623cec2b39c2507c97d38e15573  extra_platforms-13.5.1.tar.gz
"
