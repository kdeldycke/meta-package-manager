<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2015/06/nuspec.xsd">
  <metadata>
    <id>meta-package-manager</id>
    <version>7.6.1</version>
    <title>Meta Package Manager</title>
    <authors>Kevin Deldycke</authors>
    <owners>denim924</owners>
    <summary>CLI that wraps all package managers with a unifying interface.</summary>
    <description><![CDATA[Meta Package Manager (`mpm`) is a CLI that wraps multiple package managers behind a unified interface. It supports 100+ package managers across Linux, macOS, and Windows: Homebrew, apt, pip, npm, Scoop, Chocolatey, winget, Cargo, and many more.

With a single command you can list installed packages, search for new ones, install, upgrade, remove, and sync across all detected managers. Output formats include tables, JSON, and CSV.

## Usage

```
mpm --help
mpm managers
mpm installed
mpm outdated
mpm upgrade
mpm search python
```

## Documentation

Full documentation at https://mpm.run/
]]></description>
    <projectUrl>https://github.com/kdeldycke/meta-package-manager</projectUrl>
    <packageSourceUrl>https://github.com/kdeldycke/meta-package-manager/tree/main/packaging/choco/meta-package-manager</packageSourceUrl>
    <projectSourceUrl>https://github.com/kdeldycke/meta-package-manager</projectSourceUrl>
    <docsUrl>https://mpm.run/</docsUrl>
    <bugTrackerUrl>https://github.com/kdeldycke/meta-package-manager/issues</bugTrackerUrl>
